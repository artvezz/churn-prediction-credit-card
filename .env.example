# Copie este arquivo para .env e preencha os valores.

# --- Supabase (obrigatorio no modo supabase; preencha a URL e a service role key) ---
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.SERVICE_ROLE_KEY
# Usada pelo dashboard (Streamlit) para leitura da view v_priorizados (anon, somente-leitura)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.ANON_KEY

# --- Servico de scoring ---
# supabase: le/grava no Supabase | local: le data/raw/BankChurners.csv e grava em data/processed/
CHURN_SOURCE=supabase
# Chave opcional que o n8n envia em X-API-Key ao chamar /run-scoring
RUN_API_KEY=troque-por-um-segredo

# --- n8n ---
N8N_ENCRYPTION_KEY=troque-por-uma-string-aleatoria-longa
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=troque-esta-senha